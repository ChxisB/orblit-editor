<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Orblit.HeadlessSupport" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Orblit.HeadlessSupport" />
    <ProjectReference Include="..\Orblit.Editor\Orblit.Editor.csproj" />
    <ProjectReference Include="..\Orblit.Editor.Core\Orblit.Editor.Core.csproj" />
    <ProjectReference Include="..\Orblit.Editor.Panels\Orblit.Editor.Panels.csproj" />
    <ProjectReference Include="..\Orblit.Editor.Viewport\Orblit.Editor.Viewport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The games under Fixtures are built by a test, as game projects of their own. They are not part of the tests. -->
    <Compile Remove="Fixtures\**" />
    <!-- Avalonia gathers every .axaml by glob, and a game's XAML is compiled by the game's own project. -->
    <AvaloniaXaml Remove="Fixtures\**" />
    <!-- Avalonia's targets also drop every .axaml from None, so the game's XAML is copied as content. -->
    <Content Include="Fixtures\**\*.axaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
